{
  "manifest_version": 3,
  "name": "CMS · EBM",
  "version": "0.11.0",
  "description": "Traz o pedido do EBM4Web — PDF para a Detalhada, planilha para o Controle de Estoque — e confere no EBM os pedidos mãe que a DISPO vai desmembrar.",

  "permissions": ["tabs", "downloads", "storage", "alarms"],

  "host_permissions": [
    "file:///*",
    "https://*.vulcabras.com.br/*",
    "https://vulcabras.com.br/*",
    "https://cms-representacoes.github.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": [
        "https://*.vulcabras.com.br/ebm4web/*",
        "https://vulcabras.com.br/ebm4web/*"
      ],
      "js": ["ebm-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.vulcabras.com.br/ebm4web/*",
        "https://vulcabras.com.br/ebm4web/*"
      ],
      "js": ["ebm.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vulcabras.com.br/ebm4web/*",
        "https://vulcabras.com.br/ebm4web/*"
      ],
      "js": ["desm-ebm.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cms-representacoes.github.io/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["detalhada.js", "desm-ponte.js"],
      "run_at": "document_start"
    }
  ]
}
