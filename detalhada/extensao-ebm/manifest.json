{
  "manifest_version": 3,
  "name": "CMS · PDF de Encomendas",
  "version": "0.2.0",
  "description": "Gera o PDF do pedido no EBM4Web a partir das encomendas marcadas no app Detalhada.",

  "permissions": ["tabs", "downloads", "storage", "alarms"],

  "host_permissions": [
    "https://*.vulcabras.com.br/*",
    "https://vulcabras.com.br/*",
    "https://cms-representacoes.github.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": [
        "https://*.vulcabras.com.br/ebm4web/*",
        "https://vulcabras.com.br/ebm4web/*"
      ],
      "js": ["ebm-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.vulcabras.com.br/ebm4web/*",
        "https://vulcabras.com.br/ebm4web/*"
      ],
      "js": ["ebm.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cms-representacoes.github.io/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["detalhada.js"],
      "run_at": "document_start"
    }
  ]
}
